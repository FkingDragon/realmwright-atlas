+
+/* ---------------------------------------------------------------- Tilewright look
+   Flat charcoal cards, pixel headings in small caps, outlined buttons and
+   gold for whatever is switched on. Map labels keep their engraved serif. */
+body { font-size: 14px; }
+.panel { background: var(--panel); border-color: var(--line); box-shadow: 0 8px 24px rgba(0,0,0,.42); backdrop-filter: none; -webkit-backdrop-filter: none; }
+.plate::after { display: none; }
+.plate h1 { font: 700 21px/1.1 var(--f-display); color: var(--brass); letter-spacing: .01em; }
+.plate .meta-line { font-family: var(--f-display); font-size: 11px; letter-spacing: .1em; }
+.plate .meta-line b { color: var(--text); }
+.pop h2, .ihead h2, .mk-head h2, .town-name, .mb-open b, .loading .card div, .today, .disp b, .threat b { font-family: var(--f-display); font-weight: 500; }
+.pop h2 { font-size: 18px; color: var(--brass); }
+.ihead h2 { font-size: 22px; }
+.title-in { font-family: var(--f-display); font-weight: 500; font-size: 22px; }
